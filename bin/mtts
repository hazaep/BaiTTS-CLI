#!/bin/bash
# Shim de deprecación del antiguo `bin/mtts`.
# DEPRECADO: usa `mtts` directamente. Se eliminará en Fase 4.
>&2 echo "Aviso: 'bin/mtts' está deprecado. Usa el comando 'mtts' en su lugar (se eliminará en Fase 4)."

text="${*:-$(cat)}"
if [ -z "$text" ]; then
  >&2 echo "Uso: bin/mtts <texto>"
  exit 1
fi

tmpdir="${TMPDIR:-/data/data/com.termux/files/usr/tmp}"
outdir="$(mktemp -d "$tmpdir/mtts-shim.XXXXXX")"
printf '%s\n' "$text" > "$outdir/in.txt"

mtts --backend http://127.0.0.1:8774 -f "$outdir/in.txt" \
  --voice microsoft_es-MX-DaliaNeural-MiAndroidAccesible \
  --volume 45 --speed 40 --pitch 27 -o "$outdir"

wav="$(ls "$outdir"/*.wav 2>/dev/null | head -n 1)"
if [ -n "$wav" ] && command -v mplayer >/dev/null 2>&1; then
  mplayer "$wav"
fi

rm -rf "$outdir"
